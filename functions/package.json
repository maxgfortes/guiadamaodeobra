{
  "name": "guia-mao-de-obra-functions",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "test": "node --test test/unit.test.js",
    "test:integration": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=demo-guia node --test test/integration.test.js",
