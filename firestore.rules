rules_version = '2';

// Guia Mão de Obra — Firestore security rules
//
// Collections
//   professionals/{uid}   Professional profile. Doc id == Firebase Auth uid.
//                         `active` + `subscription` are SERVER-ONLY (Cloud Functions).
//   payments/{paymentId}  Mercado Pago payments (written only by Cloud Functions).
//   banners/{bannerId}    Home carousel (image + link), managed by admins.
//
// Principles
//   * Visitors (no account) read profiles that are published AND paid (active).
//   * A professional only writes their own profile, never billing fields.
//   * Admins (custom claim `admin`) can read everything and manage banners;
//     privileged changes (activation, deletion) go through callable functions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Image URLs must be https (Storage download URLs). Loopback http is
    // accepted so the Storage emulator works in local development.
    function isUrl(v) {
      return v is string && v.size() <= 2048
          && v.matches('^(https://|http://(localhost|127[.]0[.]0[.]1)[:/]).*');
    }

    function isUrlOrEmpty(v) {
      return v is string && (v.size() == 0 || isUrl(v));
    }

    /* ---------- professionals ---------- */

    // Fields a professional may write. Server-only fields are allowed to be
    // PRESENT (merge writes carry them along) but never changed by the client.
    function validProfessional(d) {
      return d.keys().hasOnly([
               'name', 'nameLower', 'whatsapp', 'email', 'phone',
               'specs', 'categories', 'city', 'cityLower', 'neighborhood',
               'bio', 'photoURL', 'bannerURL', 'portfolio',
               'published', 'createdAt', 'updatedAt',
               'active', 'subscription'
             ])
          && d.keys().hasAll(['name', 'whatsapp', 'email', 'specs', 'city', 'neighborhood', 'published'])
          && isStr(d.name, 2, 80)
          && isStr(d.whatsapp, 10, 20)
          && isStr(d.email, 5, 120)
          && (!('phone' in d) || isStr(d.phone, 0, 20))
          && d.specs is list && d.specs.size() >= 1 && d.specs.size() <= 12
          && (!('categories' in d) || (d.categories is list && d.categories.size() <= 12))
          && isStr(d.city, 2, 60)
          && isStr(d.neighborhood, 2, 60)
          && (!('bio' in d) || isStr(d.bio, 0, 600))
          && (!('photoURL' in d) || isUrlOrEmpty(d.photoURL))
          && (!('bannerURL' in d) || isUrlOrEmpty(d.bannerURL))
          && (!('portfolio' in d) || (d.portfolio is list && d.portfolio.size() <= 12
              && (d.portfolio.size() == 0 || isUrl(d.portfolio[0]))))
          && d.published is bool
          && d.updatedAt == request.time;
    }

    function isListed(d) {
      return d.published == true && d.active == true;
    }

    match /professionals/{uid} {
      allow get: if isListed(resource.data) || isOwner(uid) || isAdmin();
      // Public queries must filter published == true AND active == true.
      allow list: if isListed(resource.data) || isAdmin();

      allow create: if isOwner(uid)
                    && validProfessional(request.resource.data)
                    && !('active' in request.resource.data)
                    && !('subscription' in request.resource.data)
                    && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
                    && validProfessional(request.resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['active', 'subscription', 'createdAt']);

      allow delete: if isOwner(uid);
    }

    /* ---------- payments (server-written) ---------- */

    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    /* ---------- banners (home carousel) ---------- */

    // Banner = image + optional link (opened in a new tab by the app).
    function validBanner(d) {
      return d.keys().hasOnly(['imageURL', 'link', 'alt', 'active', 'order', 'updatedAt'])
          && isUrl(d.imageURL)
          && (!('link' in d) || (d.link is string && (d.link.size() == 0
              || (d.link.size() <= 500 && d.link.matches('^https?://.+')))))
          && (!('alt' in d) || isStr(d.alt, 0, 120))
          && d.active is bool
          && d.order is number;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update: if isAdmin() && validBanner(request.resource.data);
      allow delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
